{
  "name": "iqv2-generator",
  "version": "0.1.0",
  "description": "Offline IQv2 authoring, validation and print studio for Akademiya",
  "private": true,
  "main": "electron/main.cjs",
  "author": {
    "name": "hyjys",
    "email": "180629309+hyjys@users.noreply.github.com",
    "url": "https://github.com/hyjys"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyjys/IQv2-generator.git"
  },
  "bin": {
    "iqv2": "scripts/iqv2.cjs"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "dev:web": "vite --host 127.0.0.1",
    "start": "electron .",
    "build": "tsx scripts/build-print-assets.ts && node scripts/build-cli.cjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "cli": "node scripts/iqv2.cjs",
    "dist": "npm run build && electron-builder --publish never",
    "pack": "npm run build && electron-builder --dir --publish never",
    "test:ui": "tsx tests/render-audit-prepare.ts && node tests/ui-smoke.cjs",
    "test:render": "tsx tests/render-audit-prepare.ts && electron tests/render-visual-audit.cjs",
    "predev": "tsx scripts/build-print-assets.ts",
    "predev:web": "tsx scripts/build-print-assets.ts",
    "test:services": "node scripts/service-smoke.cjs"
  },
  "build": {
    "appId": "kr.akademiya.iqv2generator",
    "productName": "IQv2 Generator",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "scripts/**/*",
      "resources/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/katex/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "AKADEMIYA_AI_INTEGRATION.md"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/branding/icon.ico",
      "signExecutable": false,
      "artifactName": "IQv2-Generator-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "IQv2-Generator-${version}-windows-${arch}-setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "icon": "assets/branding/icon.icns",
      "artifactName": "IQv2-Generator-${version}-macos-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "assets/branding/icon.png",
      "artifactName": "IQv2-Generator-${version}-linux-${arch}.${ext}"
    },
    "artifactName": "IQv2-Generator-${version}-${os}-${arch}.${ext}",
    "afterAllArtifactBuild": "scripts/normalize-artifacts.cjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "5.3.1",
    "katex": "0.19.0",
    "markdown-it": "15.0.3",
    "markdown-it-cjk-friendly": "3.0.0",
    "markdown-it-texmath": "1.0.0",
    "pdf-lib": "1.17.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/katex": "0.16.8",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.5",
    "concurrently": "10.0.6",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wait-on": "9.5.1"
  },
  "type": "module",
  "overrides": {
    "global-agent": "4.1.3"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "homepage": "https://github.com/hyjys/IQv2-generator#readme"
}
